# Required for the Gemini API.
GOOGLE_API_KEY=

# Set this to a Gemini model available to your account.
GEMINI_MODEL=gemini-3-flash-preview

# Optional generation controls.
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=16384

# Optional request controls. Timeout is milliseconds; attempts includes the first request.
GEMINI_TIMEOUT_MS=300000
GEMINI_RETRY_ATTEMPTS=3
